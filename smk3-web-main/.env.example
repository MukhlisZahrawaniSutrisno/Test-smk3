# ==============================================================================
# TEMPLATE ENVIRONMENT VARIABLES UNTUK SMK3 MONITORING
# Salin file ini menjadi .env di server atau di laptop: cp .env.example .env
# ==============================================================================

# 1. DATABASE URL
# - Jika di Laptop (Docker terhubung ke PostgreSQL Laptop):
#   DATABASE_URL="postgresql://user_db:password_db@host.docker.internal:5432/smk3_db?schema=public"
# - Jika di Server (Docker terhubung ke PostgreSQL Server):
#   DATABASE_URL="postgresql://user_db:password_db@host_atau_ip_db:5432/nama_db?schema=public"
DATABASE_URL="postgresql://user_db:password_db@host.docker.internal:5432/smk3_db?schema=public"

# 2. PORT MAPPING
# Port yang dibuka di host (server/laptop) untuk mengakses aplikasi
PORT_BIND=3065

# 3. AUTH SECRET (Jika diperlukan)
NEXTAUTH_URL="http://localhost:3065"
NEXTAUTH_SECRET=""

# 4. WHATSAPP GATEWAY (EARLY WARNING SYSTEM K3)
# Pilihan Provider: FONNTE | WABLAS | META
WA_PROVIDER="FONNTE"
WA_API_TOKEN="masukkan_token_gateway_anda_di_sini"
WA_GATEWAY_URL="https://api.fonnte.com/send"
# Jika menggunakan META WhatsApp Cloud API, isi Phone Number ID:
# WA_META_PHONE_NUMBER_ID=""

# 5. NOTIFIKASI APAR (cron harian dan email perusahaan)
# Isi secret acak panjang; scheduler mengirim Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# Nomor fallback jika picNomorWa pada APAR kosong
APAR_WA_TO=""
APAR_EMAIL_TO=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
